# Banco de dados
POSTGRES_DB=consultoriafit
POSTGRES_USER=consultoriafit
POSTGRES_PASSWORD=consultoriafit
POSTGRES_PORT=5432

# API
PORT=3333
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Use "mock" para testar sem consumir créditos, ou informe uma chave OpenAI válida.
OPENAI_API_KEY=mock
# Modelo usado somente quando uma chave real estiver configurada.
OPENAI_MODEL=gpt-4o-mini
# Origem autorizada pelo CORS da API. Separe múltiplas origens por vírgula.
WEB_ORIGIN=http://localhost:3000

# Pagamentos e controle de acesso (valores mock mantêm o teste local isolado).
MERCADO_PAGO_ACCESS_TOKEN=mock_token
MERCADO_PAGO_WEBHOOK_SECRET=mock_secret

# Informe aqui o endpoint HTTP completo do provedor de WhatsApp.
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=mock_key

# Web
WEB_PORT=3000
# URL acessível pelo navegador no Windows (inclua o prefixo /api).
NEXT_PUBLIC_API_URL=http://localhost:3333/api
